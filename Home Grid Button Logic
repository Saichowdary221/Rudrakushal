var Kushal = window.Kushal || {};

Kushal.AdmissionGrid = {
    showSelected: async function (selectedControl) {
        try {
            // Replace with your Admission Stage column's logical name.
            var stageColumn = "kt_admissionstage";

            if (!selectedControl ||
                typeof selectedControl.getGrid !== "function") {
                throw new Error(
                    "Configure the button parameter as SelectedControl."
                );
            }

            var selectedRows = selectedControl
                .getGrid()
                .getSelectedRows();

            if (selectedRows.getLength() === 0) {
                await Xrm.Navigation.openAlertDialog({
                    title: "Select records",
                    text: "Please select at least one admission enquiry."
                });
                return;
            }

            // Capture selected record details before retrieving data.
            var selectedRecords = [];

            selectedRows.forEach(function (row) {
                var entity = row.getData().getEntity();

                selectedRecords.push({
                    id: entity.getId().replace(/[{}]/g, ""),
                    name: entity.getPrimaryAttributeValue() || "(Unnamed)",
                    table: entity.getEntityName()
                });
            });

            var messages = [];

            for (var i = 0; i < selectedRecords.length; i++) {
                var record = selectedRecords[i];

                var result = await Xrm.WebApi.retrieveRecord(
                    record.table,
                    record.id,
                    "?$select=" + stageColumn
                );

                // Formatted value gives the choice label.
                var stageText = result[
                    stageColumn +
                    "@OData.Community.Display.V1.FormattedValue"
                ];

                if (!stageText) {
                    stageText = result[stageColumn] == null
                        ? "Not set"
                        : String(result[stageColumn]);
                }

                messages.push(
                    (i + 1) + ". " + record.name +
                    "\nAdmission Stage: " + stageText +
                    "\nID: " + record.id
                );
            }

            await Xrm.Navigation.openAlertDialog(
                {
                    title: "Selected Admission Enquiries",
                    text: "Selected count: " + selectedRecords.length +
                        "\n\n" + messages.join("\n\n"),
                    confirmButtonLabel: "OK"
                },
                { width: 550, height: 450 }
            );
        } catch (error) {
            await Xrm.Navigation.openErrorDialog({
                message: error.message || String(error)
            });
        }
    }
};

