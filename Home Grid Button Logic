var Kushal = window.Kushal || {};

Kushal.AdmissionGrid = {
    showSelected: async function (selectedControl) {
        try {
            if (!selectedControl ||
                typeof selectedControl.getGrid !== "function") {
                throw new Error(
                    "Configure the button parameter as SelectedControl."
                );
            }

            var selectedRows = selectedControl
                .getGrid()
                .getSelectedRows();

            if (selectedRows.getLength() === 0) {
                await Xrm.Navigation.openAlertDialog({
                    title: "Select records",
                    text: "Please select at least one admission enquiry."
                });
                return;
            }

            var records = [];

            selectedRows.forEach(function (row, index) {
                var entity = row.getData().getEntity();

                records.push(
                    (index + 1) + ". " +
                    (entity.getPrimaryAttributeValue() || "(Unnamed)") +
                    "\nID: " + entity.getId().replace(/[{}]/g, "")
                );
            });

            await Xrm.Navigation.openAlertDialog(
                {
                    title: "Selected Admission Enquiries",
                    text: "Selected count: " +
                        selectedRows.getLength() +
                        "\n\n" + records.join("\n\n"),
                    confirmButtonLabel: "OK"
                },
                { width: 550, height: 400 }
            );
        } catch (error) {
            await Xrm.Navigation.openErrorDialog({
                message: error.message || String(error)
            });
        }
    }
};

