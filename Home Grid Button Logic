var Kushal = window.Kushal || {};

Kushal.AdmissionSubgrid = {

    // Author: Sai Kushal Chowdary
    // Senior D365 CRM Technical Consultant

    showSelectedEnquiries: function (primaryControl, selectedControl) {
        try {
            var formContext = primaryControl;
            var gridContext = selectedControl;

            if (!gridContext || !gridContext.getGrid()) {
                Xrm.Navigation.openAlertDialog({
                    text: "Subgrid is unavailable. Check the SelectedControl parameter."
                });
                return;
            }

            // Read selected Admission Enquiry records.
            var selectedRows = gridContext.getGrid().getSelectedRows();

            if (selectedRows.getLength() === 0) {
                Xrm.Navigation.openAlertDialog({
                    text: "Please select at least one Admission Enquiry."
                });
                return;
            }

            // Parent Student record.
            var studentId = formContext.data.entity
                .getId()
                .replace(/[{}]/g, "");

            var studentRecordName =
                formContext.data.entity.getPrimaryAttributeValue() || "";

            var message = [
                "Student record: " + studentRecordName,
                "Student ID: " + studentId,
                "Selected enquiries: " + selectedRows.getLength(),
                ""
            ];

            selectedRows.forEach(function (row, index) {
                var enquiry = row.getData().getEntity();

                var enquiryId = enquiry.getId().replace(/[{}]/g, "");
                var enquiryName = enquiry.getPrimaryAttributeValue() || "";
                var tableName = enquiry.getEntityName();

                message.push(
                    (index + 1) + ". " + enquiryName,
                    "Table: " + tableName,
                    "Record ID: " + enquiryId,
                    ""
                );
            });

            Xrm.Navigation.openAlertDialog(
                {
                    title: "Selected Admission Enquiries",
                    text: message.join("\n"),
                    confirmButtonLabel: "OK"
                },
                {
                    width: 600,
                    height: 450
                }
            );

        } catch (error) {
            Xrm.Navigation.openErrorDialog({
                message: error.message
            });
        }
    }
};
